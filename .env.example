# ---- PUBLIC (sent to the browser; safe to expose) ----
NEXT_PUBLIC_APP_NAME=Sabi Play
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase anon / publishable key. Protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- SECRET (server only; NEVER prefix with NEXT_PUBLIC_) ----
# Not used by any V1 code path. Reserved for future privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=
